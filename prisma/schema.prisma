model GameRewardClaim {
  id                      String                  @id @default(cuid())
  miniAppId               String                  @map("mini_app_id")
  userId                  String                  @map("user_id")
  attemptId               String?                 @map("attempt_id")
  gameKey                 String                  @default("memory-match") @map("game_key")
  quizSessionId           String?                 @map("quiz_session_id")
  tapCollectorSessionId   String?                 @map("tap_collector_session_id")
  tapSpawnEventId         String?                 @map("tap_spawn_event_id")
  wave                    Int?
  questionPosition        Int?                    @map("question_position")
  claimContext            String?                 @map("claim_context")
  level                   Int
  pairSlot                Int                     @map("pair_slot")
  rewardType              RewardType              @map("reward_type")
  status                  RewardClaimStatus       @default(MATCHED)
  configuredMoneyAmount   Decimal?                @map("configured_money_amount") @db.Decimal(18, 6)
  configuredMultiplierMin Int?                    @map("configured_multiplier_min")
  configuredMultiplierMax Int?                    @map("configured_multiplier_max")
  issuedMultiplier        Int?                    @map("issued_multiplier")
  internalAdRequestId     String?                 @unique @map("internal_ad_request_id")
  providerEventId         String?                 @unique @map("provider_event_id")
  matchedAt               DateTime                @default(now()) @map("matched_at")
  adRequestedAt           DateTime?               @map("ad_requested_at")
  browserCompletedAt      DateTime?               @map("browser_completed_at")
  providerVerifiedAt      DateTime?               @map("provider_verified_at")
  creditedAt              DateTime?               @map("credited_at")
  retryCount              Int                     @default(0) @map("retry_count")
  nextRetryAt             DateTime?               @map("next_retry_at")
  expiresAt               DateTime                @map("expires_at")
  errorCode               String?                 @map("error_code")
  errorMessage            String?                 @map("error_message")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  miniApp                 MiniApp                 @relation(fields: [miniAppId], references: [id], onDelete: Cascade)
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt                 MemoryMatchAttempt?     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizSession             QuizSession?            @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  tapCollectorSession     TapCollectorSession?    @relation(fields: [tapCollectorSessionId], references: [id], onDelete: Cascade)
  tapSpawnEvent           TapCollectorSpawnEvent? @relation(fields: [tapSpawnEventId], references: [id], onDelete: SetNull)
  walletTransaction       WalletTransaction?      @relation(fields: [walletTransactionId], references: [id])
  walletTransactionId     String?                 @unique @map("wallet_transaction_id")
  adsGalaxyAdRequests     AdsGalaxyAdRequest[]
  mazeRunnerAttemptId     String?                 @map("maze_runner_attempt_id")
  mazeRunnerAttempt       MazeRunnerAttempt?      @relation(fields: [mazeRunnerAttemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, pairSlot, rewardType])
  @@unique([quizSessionId, questionPosition, claimContext])
  @@unique([tapCollectorSessionId, wave, claimContext])
  @@unique([tapSpawnEventId, claimContext])
  @@index([miniAppId, userId, status])
  @@index([expiresAt, status])
  @@index([mazeRunnerAttemptId, claimContext])
  @@map("game_reward_claims")
}

