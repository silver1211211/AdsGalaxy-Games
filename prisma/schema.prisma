}

model User {
  id                      String                      @id @default(cuid())
  telegramId              BigInt                      @unique @map("telegram_id")
  username                String?
  firstName               String                      @map("first_name")
  lastName                String?                     @map("last_name")
  language                String?                     @db.VarChar(10)
  avatar                  String?
  country                 String?                     @db.VarChar(2)
  telegramPremium         Boolean?                    @map("telegram_premium")
  telegramSyncedAt        DateTime?                   @map("telegram_synced_at")
  referralCode            String                      @unique @map("referral_code")
  referredById            String?                     @map("referred_by")
  totalPoints             Int                         @default(0) @map("total_points")
  totalRewards            Decimal                     @default(0) @map("total_rewards") @db.Decimal(18, 6)
  totalGames              Int                         @default(0) @map("total_games")
  walletBalance           Decimal                     @default(0) @map("wallet_balance") @db.Decimal(18, 6)
  status                  UserStatus                  @default(ACTIVE)
  superAdminTheme         String                      @default("LIGHT") @map("super_admin_theme") @db.VarChar(8)
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  referredBy              User?                       @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                      @relation("UserReferrals")
  transactions            WalletTransaction[]
  gameSessions            GameSession[]
  gameScores              GameScore[]
  taskCompletions         TaskCompletion[]
  withdrawals             Withdrawal[]
  notifications           Notification[]
  memoryMatchStats        MemoryMatchStats?
  achievements            UserAchievement[]
  memberships             MiniAppMembership[]
  wallets                 Wallet[]
  pointTransactions       PointTransaction[]
  memoryAttempts          MemoryMatchAttempt[]
  rewardClaims            GameRewardClaim[]
  adminAuditLogs          AdminAuditLog[]             @relation("AuditActor")
  quizQuestions           QuizQuestion[]              @relation("QuizQuestionCreator")
  quizSessions            QuizSession[]
  tapCollectorSessions    TapCollectorSession[]
  mazeRunnerAttempts      MazeRunnerAttempt[]
  mazeRunnerProgress      MazeRunnerProgress[]
  pointConversions        PointConversion[]
  walletAdjustments       WalletAdjustment[]          @relation("WalletAdjustmentTarget")
  taskAttempts            TaskAttempt[]
  taskSubmissions         TaskSubmission[]
  profiles                MiniAppUserProfile[]
  appSessions             AppSession[]
  dataExportRequests      DataExportRequest[]
  deletionRequests        AccountDeletionRequest[]
  adminNotesAuthored      AdminUserNote[]             @relation("AdminNoteAuthor")
  adminNotesReceived      AdminUserNote[]             @relation("AdminNoteSubject")
  superAdminNotesAuthored SuperAdminUserNote[]        @relation("SuperAdminNoteAuthor")
  superAdminNotesReceived SuperAdminUserNote[]        @relation("SuperAdminNoteSubject")
  miniAppRequests         MiniAppRequest[]            @relation("MiniAppRequestApplicant")
  reviewedMiniAppRequests MiniAppRequest[]            @relation("MiniAppRequestReviewer")
  miniAppRequestMessages  MiniAppRequestMessage[]
  miniAppRequestEvents    MiniAppRequestStatusEvent[]
  adminCredentials        AdminCredential[]           @relation("AdminCredentialOwner")
  adminCredentialResets   AdminCredential[]           @relation("AdminCredentialResetBy")
  adminElevationSessions  AdminElevationSession[]

  @@index([status])
  @@map("users")
}

model Wallet {
  id                    String              @id @default(cuid())
  miniAppId             String              @map("mini_app_id")
  userId                String              @map("user_id")
  availableBalance      Decimal             @default(0) @map("available_balance") @db.Decimal(18, 6)
  pendingBalance        Decimal             @default(0) @map("pending_balance") @db.Decimal(18, 6)
  withdrawalHoldBalance Decimal             @default(0) @map("withdrawal_hold_balance") @db.Decimal(18, 6)
  lifetimeEarnings      Decimal             @default(0) @map("lifetime_earnings") @db.Decimal(18, 6)
  totalWithdrawn        Decimal             @default(0) @map("total_withdrawn") @db.Decimal(18, 6)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  miniApp               MiniApp             @relation(fields: [miniAppId], references: [id], onDelete: Cascade)
  transactions          WalletTransaction[]
  withdrawals           Withdrawal[]
  conversions           PointConversion[]

  @@unique([miniAppId, userId])
  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id                   String            @id @default(cuid())
  userId               String            @map("user_id")
  miniAppId            String            @map("mini_app_id")
  walletId             String            @map("wallet_id")
  type                 TransactionType
  status               TransactionStatus @default(PENDING)
  amount               Decimal           @db.Decimal(18, 6)
  currency             String            @default("USD") @db.VarChar(3)
  balanceBefore        Decimal?          @map("balance_before") @db.Decimal(18, 6)
  balanceAfter         Decimal?          @map("balance_after") @db.Decimal(18, 6)
  referenceId          String?           @map("reference_id")
  description          String?
  metadata             Json?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  completedAt          DateTime?         @map("completed_at")
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  miniApp              MiniApp           @relation(fields: [miniAppId], references: [id], onDelete: Cascade)
  wallet               Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  rewardClaim          GameRewardClaim?
  conversion           PointConversion?
  withdrawalHold       Withdrawal?       @relation("WithdrawalHoldTransaction")
  withdrawalCompletion Withdrawal?       @relation("WithdrawalCompletionTransaction")
  withdrawalReversal   Withdrawal?       @relation("WithdrawalReversalTransaction")
  adjustment           WalletAdjustment?

  @@unique([miniAppId, referenceId])
  @@index([userId, createdAt])
  @@index([status, type])
  @@map("wallet_transactions")
}

model Game {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  description      String
  status           GameStatus    @default(DRAFT)
  difficulty       String?
  estimatedSeconds Int?          @map("estimated_seconds")
  rewardMin        Int           @default(0) @map("reward_min")
  rewardMax        Int           @default(0) @map("reward_max")
  config           Json?
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  sessions         GameSession[]
  scores           GameScore[]

  @@index([status, sortOrder])
  @@map("games")
}

model GameSession {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  gameId       String        @map("game_id")
  status       SessionStatus @default(STARTED)
  pointsEarned Int           @default(0) @map("points_earned")
  rewardEarned Decimal       @default(0) @map("reward_earned") @db.Decimal(18, 6)
  startedAt    DateTime      @default(now()) @map("started_at")
  completedAt  DateTime?     @map("completed_at")
  metadata     Json?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  scores       GameScore[]

  @@index([userId, startedAt])
  @@index([gameId, status])
  @@map("game_sessions")
}

model MiniApp {
  id                      String                       @id @default(cuid())
  name                    String
  slug                    String                       @unique
  status                  MiniAppStatus                @default(ACTIVE)
  telegramBotReference    String?                      @map("telegram_bot_reference")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  memberships             MiniAppMembership[]
  wallets                 Wallet[]
  walletTransactions      WalletTransaction[]
  pointTransactions       PointTransaction[]
  gameSettings            MemoryMatchSettings?
  adConfiguration         AdsGalaxyConfiguration?
  mazeRunnerSettings      MazeRunnerSettings?
  mazeRunnerAttempts      MazeRunnerAttempt[]
  mazeRunnerProgress      MazeRunnerProgress[]
  attempts                MemoryMatchAttempt[]
  rewardClaims            GameRewardClaim[]
  entitlements            RewardEntitlement[]
  dailyUsage              RewardDailyUsage[]
  auditLogs               AdminAuditLog[]
  quizSettings            QuizSettings?
  quizCategories          MiniAppQuizCategory[]
  ownedQuizCategories     QuizCategory[]
  quizQuestions           QuizQuestion[]
  quizSessions            QuizSession[]
  quizDailyChallenges     QuizDailyChallenge[]
  tapCollectorSettings    TapCollectorSettings?
  tapCollectorSessions    TapCollectorSession[]
  tapCollectorDailyHunts  TapCollectorDailyHunt[]
  walletSettings          WalletSettings?
  payoutMethods           WalletPayoutMethod[]
  withdrawals             Withdrawal[]
  pointConversions        PointConversion[]
  walletAdjustments       WalletAdjustment[]
  tasks                   Task[]
  taskSettings            TaskSettings?
  taskAttempts            TaskAttempt[]
  taskSubmissions         TaskSubmission[]
  userProfiles            MiniAppUserProfile[]
  appSessions             AppSession[]
  dataExportRequests      DataExportRequest[]
  deletionRequests        AccountDeletionRequest[]
  adminUserNotes          AdminUserNote[]
  adminSettings           TenantAdminSettings?
  botConfiguration        TenantBotConfiguration?
  adminNotifications      TenantAdminNotification[]
  oxaPayCredential        TenantOxaPayCredential?
  oxaPayPayoutAttempts    OxaPayPayoutAttempt[]
  gamePlatformOverrides   GameTenantOverride[]
  sponsoredTargets        SponsoredCampaignTenant[]
  sponsoredEvents         SponsoredCampaignEvent[]
  platformAlerts          PlatformAlert[]
  inactivityEvaluations   TenantInactivityEvaluation[]
  inactivityExempt        Boolean                      @default(false) @map("inactivity_exempt")
  inactivityExemptReason  String?                      @map("inactivity_exempt_reason") @db.VarChar(300)
  inactivityExemptUntil   DateTime?                    @map("inactivity_exempt_until")
  inactivitySuspendedAt   DateTime?                    @map("inactivity_suspended_at")
  inactivityResumeAt      DateTime?                    @map("inactivity_resume_at")
  inactivityReason        String?                      @map("inactivity_reason") @db.VarChar(32)
  inactivityLastCheckedAt DateTime?                    @map("inactivity_last_checked_at")
  sourceRequest           MiniAppRequest?
  adminElevationSessions  AdminElevationSession[]

  @@map("mini_apps")
}

model MiniAppRequest {
  id                        String                      @id @default(cuid())
  publicReference           String                      @unique @map("public_reference") @db.VarChar(20)
  applicantUserId           String?                     @map("applicant_user_id")
  applicantName             String                      @map("applicant_name") @db.VarChar(160)
  telegramUsername          String?                     @map("telegram_username") @db.VarChar(64)
  requestOrigin             String                      @default("WEB") @map("request_origin") @db.VarChar(16)
  statusAccessTokenHash     String                      @map("status_access_token_hash") @db.VarChar(64)
  proposedName              String                      @map("proposed_name") @db.VarChar(100)
  requestedSlug             String                      @map("requested_slug") @db.VarChar(40)
  description               String                      @db.VarChar(500)
  intendedAudience          String                      @map("intended_audience") @db.VarChar(500)
  category                  String                      @db.VarChar(32)
  contactMethod             String                      @map("contact_method") @db.VarChar(160)
  primaryPromotionChannel   String                      @map("primary_promotion_channel") @db.VarChar(32)
  primaryPromotionUrl       String                      @map("primary_promotion_url") @db.VarChar(500)
  estimatedAudienceSize     Int                         @map("estimated_audience_size")
  expectedFirstWeekUsers    Int                         @map("expected_first_week_users")
  promotionPlan             String                      @map("promotion_plan") @db.VarChar(2000)
  additionalLinks           Json                        @default("[]") @map("additional_links")
  status                    MiniAppRequestStatus        @default(SUBMITTED)
  assignedReviewerId        String?                     @map("assigned_reviewer_id")
  publicStatusMessage       String?                     @map("public_status_message") @db.VarChar(1000)
  privateReviewNote         String?                     @map("private_review_note") @db.VarChar(2000)
  idempotencyKey            String                      @unique @map("idempotency_key") @db.VarChar(100)
  submittedAt               DateTime                    @default(now()) @map("submitted_at")
  reviewStartedAt           DateTime?                   @map("review_started_at")
  approvedAt                DateTime?                   @map("approved_at")
  rejectedAt                DateTime?                   @map("rejected_at")
  canceledAt                DateTime?                   @map("canceled_at")
  expiresAt                 DateTime                    @map("expires_at")
  createdMiniAppId          String?                     @unique @map("created_mini_app_id")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  adminCredentialIssuedAt   DateTime?                   @map("admin_credential_issued_at")
  adminCredentialRevealedAt DateTime?                   @map("admin_credential_revealed_at")
  deviceIdentifierHash      String                      @map("device_identifier_hash") @db.VarChar(64)
  applicant                 User?                       @relation("MiniAppRequestApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  assignedReviewer          User?                       @relation("MiniAppRequestReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  createdMiniApp            MiniApp?                    @relation(fields: [createdMiniAppId], references: [id], onDelete: SetNull)
  messages                  MiniAppRequestMessage[]
  events                    MiniAppRequestStatusEvent[]
  reservation               MiniAppSlugReservation?

  @@index([applicantUserId, status, createdAt])
  @@index([status, submittedAt])
  @@index([deviceIdentifierHash, status])
  @@map("mini_app_requests")
}

model MiniAppRequestSubmissionOverride {
  id                   String    @id @default(cuid())
  userId               String?   @map("user_id")
  deviceIdentifierHash String?   @map("device_identifier_hash") @db.VarChar(64)
  reason               String    @db.VarChar(500)
  grantedByUserId      String    @map("granted_by_user_id")
  expiresAt            DateTime  @map("expires_at")
  consumedAt           DateTime? @map("consumed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([userId, consumedAt, expiresAt])
  @@index([deviceIdentifierHash, consumedAt, expiresAt])
  @@map("mini_app_request_submission_overrides")
}

model MiniAppRequestMessage {
  id           String                          @id @default(cuid())
  requestId    String                          @map("request_id")
  senderType   MiniAppRequestSender            @map("sender_type")
  senderUserId String?                         @map("sender_user_id")
  message      String                          @db.VarChar(2000)
  visibility   MiniAppRequestMessageVisibility @default(PUBLIC)
  createdAt    DateTime                        @default(now()) @map("created_at")
  request      MiniAppRequest                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender       User?                           @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([requestId, visibility, createdAt])
  @@map("mini_app_request_messages")
}

model MiniAppRequestStatusEvent {
  id             String                @id @default(cuid())
  requestId      String                @map("request_id")
  previousStatus MiniAppRequestStatus? @map("previous_status")
  nextStatus     MiniAppRequestStatus  @map("next_status")
  actorUserId    String?               @map("actor_user_id")
  publicMessage  String?               @map("public_message") @db.VarChar(1000)
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  request        MiniAppRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor          User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("mini_app_request_status_events")
}

model AdminCredential {
  id                    String                  @id @default(cuid())
  userId                String                  @map("user_id")
  scopeType             AdminCredentialScope    @map("scope_type")
  passwordHash          String                  @map("password_hash")
  passwordChangedAt     DateTime?               @map("password_changed_at")
  temporaryPassword     Boolean                 @default(true) @map("temporary_password")
  mustChangePassword    Boolean                 @default(true) @map("must_change_password")
  failedAttemptCount    Int                     @default(0) @map("failed_attempt_count")
  failedWindowStartedAt DateTime?               @map("failed_window_started_at")
  lockedUntil           DateTime?               @map("locked_until")
  lastVerifiedAt        DateTime?               @map("last_verified_at")
  lastSuccessfulLoginAt DateTime?               @map("last_successful_login_at")
  lastFailedLoginAt     DateTime?               @map("last_failed_login_at")
  resetByUserId         String?                 @map("reset_by_user_id")
  resetAt               DateTime?               @map("reset_at")
  credentialVersion     Int                     @default(1) @map("credential_version")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  user                  User                    @relation("AdminCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  resetBy               User?                   @relation("AdminCredentialResetBy", fields: [resetByUserId], references: [id], onDelete: SetNull)
  elevationSessions     AdminElevationSession[]

  @@unique([userId, scopeType])
  @@index([scopeType, lockedUntil])
  @@map("admin_credentials")
}

model AdminElevationSession {
  id                String               @id @default(cuid())
  tokenHash         String               @unique @map("token_hash") @db.VarChar(64)
  userId            String               @map("user_id")
  credentialId      String               @map("credential_id")
  miniAppId         String?              @map("mini_app_id")
  scopeType         AdminCredentialScope @map("scope_type")
  credentialVersion Int                  @map("credential_version")
  verifiedAt        DateTime             @default(now()) @map("verified_at")
  expiresAt         DateTime             @map("expires_at")
  revokedAt         DateTime?            @map("revoked_at")
  lastUsedAt        DateTime             @default(now()) @map("last_used_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential        AdminCredential      @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  miniApp           MiniApp?             @relation(fields: [miniAppId], references: [id], onDelete: Cascade)

  @@index([userId, scopeType, miniAppId, revokedAt, expiresAt])
  @@index([credentialId, credentialVersion])
  @@map("admin_elevation_sessions")
}

model MiniAppSlugReservation {
  id                 String                       @id @default(cuid())
