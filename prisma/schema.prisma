}

enum TaskVerificationStrength {
  VERIFIED
  REINFORCED_SELF_CONFIRMATION
  MANUAL_REVIEW
}

enum TaskRewardType {
  POINTS
  WALLET
  POINTS_AND_WALLET
  NON_FINANCIAL
}

enum TaskRepeatPolicy {
  ONCE
  DAILY
  WEEKLY
}

enum TaskAttemptStatus {
  STARTED
  DESTINATION_OPENED
  READY_TO_CONFIRM
  PENDING_VERIFICATION
  PENDING_REVIEW
  VERIFIED
  SELF_CONFIRMED
  APPROVED
  REJECTED
  REWARDED
  EXPIRED
  ABANDONED
}

enum TaskQuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  EXACT_CODE
  ACKNOWLEDGEMENT
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum WithdrawalProcessingMode {
  MANUAL
  OXAPAY_AUTOMATIC
}

enum PayoutProvider {
  OXAPAY
}

enum ProviderPayoutStatus {
  NOT_SUBMITTED
  SUBMITTING
  PENDING
  PROCESSING
  CONFIRMING
  CONFIRMED
  REJECTED
  CANCELED
  UNKNOWN
}

enum ConversionRoundingRule {
  DOWN
}

enum WalletRiskStatus {
  CLEAR
  REVIEW
  BLOCKED
}

enum NotificationType {
  SYSTEM
  REWARD
  GAME
  TASK
  WALLET
  ANNOUNCEMENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MiniAppStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MembershipRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum AttemptStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
  EXPIRED
}

enum RewardType {
  MONEY
  COIN
  WALLET
  GAME_BENEFIT
  POINT_MULTIPLIER
}

enum RewardClaimStatus {
  MATCHED
  AD_REQUESTED
  BROWSER_COMPLETED
  PENDING_VERIFICATION
  VERIFIED
  CREDITED
  CLOSED_EARLY
  NO_FILL
  FAILED
  EXPIRED
  ALREADY_CLAIMED
}

enum RepeatPolicy {
  ONCE_EVER
  DAILY
  WEEKLY
}

enum AdEnvironment {
  PRODUCTION_VERIFIED
  SANDBOX
  DEVELOPMENT_MOCK
}

enum QuizMode {
  QUICK
  CLASSIC
  CATEGORY
  DAILY
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizQuestionSource {
  GLOBAL_DEFAULT
  MINI_APP_CUSTOM
}

enum QuizQuestionStatus {
  DRAFT
  PUBLISHED
  DISABLED
  ARCHIVED
}

enum QuizReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuizSessionStatus {
  ACTIVE
  PAUSED
  AD_BREAK
  COMPLETED
  ABANDONED
  EXPIRED
}

enum TapCollectorMode {
  QUICK
  CLASSIC
  SURVIVAL
  DAILY
}

enum TapCollectorSessionStatus {
  READY
  ACTIVE
  WAVE_COMPLETE
  AD_BREAK
  PAUSED
  GAME_OVER
  COMPLETED
  ABANDONED
  EXPIRED
