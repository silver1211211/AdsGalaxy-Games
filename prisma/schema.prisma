}

enum TapItemType {
  COIN
  MONEY
  GEM
  STAR
  CLOCK
  SHIELD
  MAGNET
  FREEZE
  BOMB
  TRAP
  SPONSORED_CRATE
}

enum TapItemClass {
  STANDARD
  COIN_REWARD
  MONEY_REWARD
  HAZARD
}

enum TapMovementType {
  STATIC
  DRIFT_LEFT
  DRIFT_RIGHT
  DRIFT_UP
  DRIFT_DOWN
  BOUNCE
  ZIGZAG
  CIRCLE
}

enum TapSpawnStatus {
  SCHEDULED
  COLLECTED
  MISSED
  EXPIRED
  CANCELLED
}

enum AppSessionSource {
  TELEGRAM
  LOCAL_DEVELOPMENT
  SUPER_ADMIN_BROWSER
}

enum ProfileTheme {
  SYSTEM
  LIGHT
  DARK
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
  CANCELLED
}

enum MiniAppRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INFORMATION_REQUIRED
  APPROVED
  REJECTED
  CANCELED
  EXPIRED
}

enum MiniAppRequestSender {
  APPLICANT
  SUPER_ADMIN
  SYSTEM
}

enum MiniAppRequestMessageVisibility {
  PUBLIC
  PRIVATE
}

enum MiniAppSlugReservationStatus {
  RESERVED
  CONVERTED
  RELEASE_SCHEDULED
