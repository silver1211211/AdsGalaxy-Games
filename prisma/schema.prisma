  actorUserId         String             @map("actor_user_id")
  idempotencyKey      String             @map("idempotency_key")
  kind                String
  walletAmount        Decimal?           @map("wallet_amount") @db.Decimal(18, 6)
  pointsAmount        Int?               @map("points_amount")
  reason              String
  walletTransactionId String?            @unique @map("wallet_transaction_id")
  pointTransactionId  String?            @unique @map("point_transaction_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  miniApp             MiniApp            @relation(fields: [miniAppId], references: [id], onDelete: Restrict)
