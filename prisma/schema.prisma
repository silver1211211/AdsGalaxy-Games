model OxaPayCurrencyNetwork {
  id                    String               @id @default(cuid())
  currencyId            String               @map("currency_id")
  networkCode           String               @map("network_code") @db.VarChar(64)
  networkName           String               @map("network_name") @db.VarChar(100)
  isActive              Boolean              @default(true) @map("is_active")
  withdrawalMinimum     Decimal              @map("withdrawal_minimum") @db.Decimal(36, 18)
  withdrawalFee         Decimal              @map("withdrawal_fee") @db.Decimal(36, 18)
  requiredConfirmations Int?                 @map("required_confirmations")
  memoSupported         Boolean              @default(false) @map("memo_supported")
  rawMetadata           Json?                @map("raw_metadata")
  synchronizedAt        DateTime             @map("synchronized_at")
