model SponsoredCampaign {
  id               String                    @id @default(cuid())
  name             String                    @db.VarChar(120)
  sponsorName      String                    @map("sponsor_name") @db.VarChar(120)
  title            String                    @db.VarChar(160)
  description      String                    @db.VarChar(500)
  imageReference   String?                   @map("image_reference")
  buttonText       String                    @map("button_text") @db.VarChar(50)
  destinationUrl   String                    @map("destination_url")
  disclosureText   String                    @default("Sponsored") @map("disclosure_text") @db.VarChar(40)
  backgroundStyle  String                    @default("TEAL") @map("background_style") @db.VarChar(20)
  placement        String                    @db.VarChar(40)
  status           String                    @default("DRAFT") @db.VarChar(20)
  priority         Int                       @default(0)
  targetingMode    String                    @default("ALL_TENANTS") @map("targeting_mode") @db.VarChar(24)
  startsAt         DateTime?                 @map("starts_at")
  endsAt           DateTime?                 @map("ends_at")
  maxImpressions   Int?                      @map("max_impressions")
  maxClicks        Int?                      @map("max_clicks")
  perUserFrequency Int                       @default(1) @map("per_user_frequency")
  createdByUserId  String                    @map("created_by_user_id")
  updatedByUserId  String                    @map("updated_by_user_id")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  tenants          SponsoredCampaignTenant[]
  events           SponsoredCampaignEvent[]

  @@index([status, placement, startsAt, endsAt])
  @@map("sponsored_campaigns")
}

model SponsoredCampaignTenant {
  campaignId String            @map("campaign_id")
  miniAppId  String            @map("mini_app_id")
  campaign   SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  miniApp    MiniApp           @relation(fields: [miniAppId], references: [id], onDelete: Cascade)

  @@id([campaignId, miniAppId])
  @@index([miniAppId])
  @@map("sponsored_campaign_tenants")
}

model SponsoredCampaignEvent {
  id               String            @id @default(cuid())
  campaignId       String            @map("campaign_id")
  miniAppId        String            @map("mini_app_id")
  userId           String            @map("user_id")
  eventType        String            @map("event_type") @db.VarChar(16)
  placement        String            @db.VarChar(40)
  sessionReference String            @map("session_reference") @db.VarChar(100)
  deduplicationKey String            @unique @map("deduplication_key") @db.VarChar(120)
  createdAt        DateTime          @default(now()) @map("created_at")
  campaign         SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  miniApp          MiniApp           @relation(fields: [miniAppId], references: [id], onDelete: Cascade)

  @@index([campaignId, eventType, createdAt])
  @@index([miniAppId, createdAt])
  @@map("sponsored_campaign_events")
}

model TenantInactivityEvaluation {
