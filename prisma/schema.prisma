model PlatformAlertRule {
  id              String          @id @default(cuid())
  type            String          @unique @db.VarChar(64)
  enabled         Boolean         @default(true)
  threshold       Int
  windowMinutes   Int             @map("window_minutes")
  severity        String          @db.VarChar(16)
  lastTriggeredAt DateTime?       @map("last_triggered_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  alerts          PlatformAlert[]

  @@map("platform_alert_rules")
}

model PlatformAlert {
  id               String             @id @default(cuid())
  ruleId           String?            @map("rule_id")
  miniAppId        String?            @map("mini_app_id")
  type             String             @db.VarChar(64)
  severity         String             @db.VarChar(16)
  status           String             @default("OPEN") @db.VarChar(16)
  title            String             @db.VarChar(160)
  summary          String             @db.VarChar(500)
  firstDetectedAt  DateTime           @default(now()) @map("first_detected_at")
  lastDetectedAt   DateTime           @default(now()) @map("last_detected_at")
  acknowledgedById String?            @map("acknowledged_by_id")
  resolvedById     String?            @map("resolved_by_id")
  rule             PlatformAlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  miniApp          MiniApp?           @relation(fields: [miniAppId], references: [id], onDelete: SetNull)

  @@index([status, severity, lastDetectedAt])
  @@index([miniAppId, status])
  @@map("platform_alerts")
}

model WalletAdjustment {
  id                  String             @id @default(cuid())
  miniAppId           String             @map("mini_app_id")
