  quotedExchangeRate      Decimal?                 @map("quoted_exchange_rate") @db.Decimal(36, 18)
  quoteTimestamp          DateTime?                @map("quote_timestamp")
  grossCryptoAmount       Decimal?                 @map("gross_crypto_amount") @db.Decimal(36, 18)
  providerFee             Decimal?                 @map("provider_fee") @db.Decimal(36, 18)
  platformFee             Decimal?                 @map("platform_fee") @db.Decimal(18, 6)
  netCryptoAmount         Decimal?                 @map("net_crypto_amount") @db.Decimal(36, 18)
  providerStatus          ProviderPayoutStatus     @default(NOT_SUBMITTED) @map("provider_status")
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  miniApp                 MiniApp                  @relation(fields: [miniAppId], references: [id], onDelete: Restrict)
  wallet                  Wallet                   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  payoutMethod            WalletPayoutMethod       @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  holdTransaction         WalletTransaction        @relation("WithdrawalHoldTransaction", fields: [holdTransactionId], references: [id], onDelete: Restrict)
  completionTransaction   WalletTransaction?       @relation("WithdrawalCompletionTransaction", fields: [completionTransactionId], references: [id], onDelete: Restrict)
  reversalTransaction     WalletTransaction?       @relation("WithdrawalReversalTransaction", fields: [reversalTransactionId], references: [id], onDelete: Restrict)
  oxaPayAttempt           OxaPayPayoutAttempt?

  @@unique([miniAppId, userId, idempotencyKey])
  @@index([miniAppId, userId, createdAt])
  @@index([miniAppId, status, createdAt])
  @@map("withdrawals")
}

model TenantOxaPayCredential {
